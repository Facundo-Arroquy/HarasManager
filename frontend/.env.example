# Copiar este archivo a .env.local y completar los valores.
#
# DESARROLLO (lo normal): base LOCAL en Docker. Se levanta con `supabase start` desde
# la raíz del repo (ver docs/ENTORNO-LOCAL.md). La anon key es la que imprime
# `supabase status` (ANON_KEY). Usuarios de prueba: supabase/seeds/README.md.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON=anon-key-local-de-supabase-status

# PRODUCCIÓN: solo la usa Vercel, desde su panel de variables de entorno.
# No apuntar el entorno de desarrollo a producción.
# Supabase Dashboard → Settings → API
#   VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
#   VITE_SUPABASE_ANON=tu-anon-key
