# Variables de las Edge Functions para correrlas en LOCAL.
#
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY las inyecta solo
# `supabase functions serve` (apuntando a la base local). Acá van las demás.
#
# Copiar a `.env.local` (no se versiona) y correr desde la raíz del repo:
#   supabase functions serve --env-file supabase/functions/.env.local
#
# NUNCA poner acá credenciales de producción.

# Dominio del front, al que vuelve MercadoPago después del checkout
APP_URL=http://localhost:5173

# Credenciales de PRUEBA de MercadoPago (cuenta de test). Sin ellas, create-user y
# eliminar-usuario (sin suscripción) funcionan; el checkout, la cancelación y el
# webhook no.
MP_ACCESS_TOKEN=TEST-reemplazar
MP_WEBHOOK_SECRET=secreto-de-prueba
