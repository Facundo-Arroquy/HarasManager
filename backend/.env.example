# Copiar a `.env` (no se versiona). En local no hace falta: los valores por defecto
# ya apuntan a la base de Docker (`supabase start`, ver docs/ENTORNO-LOCAL.md).

# local | staging | production. En "local" el backend se niega a arrancar contra una
# base que no sea la de tu máquina.
ENVIRONMENT=local

# Conexión a Postgres. El prefijo `postgresql+psycopg://` es obligatorio (driver psycopg 3).
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55322/postgres

# Tamaño del pool de conexiones. Supabase tiene un tope bajo: no subirlo sin medir.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Orígenes del front permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Proyecto de Supabase. De acá salen el emisor esperado del JWT (<url>/auth/v1) y las claves
# públicas con las que se verifica su firma. En "local" tiene que ser el Supabase de Docker.
SUPABASE_URL=http://127.0.0.1:55321

# Solo para proyectos que firman con un secreto compartido (HS256). Local y producción usan
# claves asimétricas (ES256): dejarlo vacío.
# SUPABASE_JWT_SECRET=
